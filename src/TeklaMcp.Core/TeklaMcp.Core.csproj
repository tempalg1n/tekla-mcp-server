<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Abstractions, DTOs and backend-agnostic logic (aggregation, the IFC placement reader, the
    file-exchange formats and path policy). No Tekla, no MCP, no NuGet dependencies — parsers
    and writers here are hand-rolled so this stays dependency-free across net48 and net8.0.
    Targets netstandard2.0 so both the net8.0 and net48 server builds can reference it.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TeklaMcp.Core</RootNamespace>
  </PropertyGroup>

</Project>
